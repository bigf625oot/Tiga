  <data key="d1">方法</data>
  <data key="d2">示范学习是一种从人类示范中直接习得技能的方法论，用于优化物理技能。</data>
  <data key="d3">chunk-c1664349bf3883472a0704f460d2582f</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
