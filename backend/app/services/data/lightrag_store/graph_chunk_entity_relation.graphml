  <data key="d2">用于优化智能体学习状态到动作映射策略的函数。</data>
  <data key="d3">chunk-64f7df7aec3757b7c0ad9192079682b3</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="解耦">
  <data key="d0">解耦</data>
  <data key="d1">概念</data>
  <data key="d2">将学习过程与特定任务的奖励函数分离，使策略能在不同任务间泛化。</data>
  <data key="d3">chunk-64f7df7aec3757b7c0ad9192079682b3</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="泛化能力">
  <data key="d0">泛化能力</data>
  <data key="d1">概念</data>
  <data key="d2">智能体将某项任务积累的知识灵活运用于相关任务的能力。</data>
  <data key="d3">chunk-64f7df7aec3757b7c0ad9192079682b3</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="涌现行为">
  <data key="d0">涌现行为</data>
  <data key="d1">概念</data>
  <data key="d2">复杂行为从简单组件或规则中产生的现象。</data>
  <data key="d3">chunk-64f7df7aec3757b7c0ad9192079682b3</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="训练数据">
  <data key="d0">训练数据</data>
  <data key="d1">物品</data>
  <data key="d2">基础模型的训练依赖于从互联网收集的海量文本数据，包括书籍、文章、网站及其他文本来源，可能折射出人类社会中的偏见。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="偏见">
  <data key="d0">偏见</data>
  <data key="d1">概念</data>
  <data key="d2">训练数据中存在的与种族、性别、民族、宗教等个人属性相关的刻板印象、偏见和片面观点。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="WEIRD社会">
  <data key="d0">WEIRD社会</data>
  <data key="d1">概念</data>
  <data key="d2">西方、受过教育、工业化、富裕和民主社会的文化规范，在互联网领域占据不成比例的主导地位。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="历史文化偏见">
  <data key="d0">历史文化偏见</data>
  <data key="d1">概念</data>
  <data key="d2">历史文献与文化素材中可能含有反映特定社会文化规范、态度及偏见的冒犯性或贬损性语言。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="语言与语境局限性">
  <data key="d0">语言与语境局限性</data>
  <data key="d1">概念</data>
  <data key="d2">语言模型在理解和准确呈现语言细微差别时可能面临的挑战，如讽刺、幽默或文化典故。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="政策和指南">
  <data key="d0">政策和指南</data>
  <data key="d1">概念</data>
  <data key="d2">AI代理在严格的政策和指南下运行，以确保公平性和包容性，如生成图像时使人物描绘多样化。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="过度泛化">
  <data key="d0">过度泛化</data>
  <data key="d1">概念</data>
  <data key="d2">模型倾向于根据训练数据中看到的模式生成响应，可能导致对某些群体做出广泛假设的响应。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="持续监测和更新">
  <data key="d0">持续监测和更新</data>
  <data key="d1">概念</data>
  <data key="d2">人工智能系统会持续监测和更新，以解决任何出现的偏见或包容性问题。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="主导观点的放大">
  <data key="d0">主导观点的放大</data>
  <data key="d1">概念</data>
  <data key="d2">由于训练数据通常包含更多来自主导文化或群体的内容，模型可能更倾向于这些观点。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="伦理与包容性设计">
  <data key="d0">伦理与包容性设计</data>
  <data key="d1">概念</data>
  <data key="d2">AI工具的设计应以伦理考量和包容性为核心原则，包括尊重文化差异和促进多样性。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="用户指南">
  <data key="d0">用户指南</data>
  <data key="d1">概念</data>
  <data key="d2">指导用户如何以促进包容性和尊重的方式与AI进行互动，避免导致有偏见或不恰当输出的请求。</data>
  <data key="d3">chunk-a389a8a2ea9a6d3d8e02de008afdd801</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="Shah团队">
  <data key="d0">Shah团队</data>
  <data key="d1">组织</data>
  <data key="d2">Shah团队开发了采用语言模型和视觉模型的导航系统。</data>
  <data key="d3">chunk-d93fe735e01199c9923a37c7ae1883d6</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587361</data>
  <data key="d6"></data>
</node>
<node id="语言模型(LLM)">
  <data key="d0">语言模型(LLM)</data>
  <data key="d1">技术</data>
  <data key="d2">语言模型是基于文本或字符串表征的人工智能模型，用于预测各环境中的动作输出，但在具身人工智能领域存在明显短板。&lt;SEP&gt;语言模型用于从文本中识别地标，实现高效导航。&lt;SEP&gt;在任务规划、世界知识和逻辑推理方面表现出色的AI模型。&lt;SEP&gt;语言模型在任务辅助机器人技术(TAMP)领域具有天然优势，用于高层级任务规划。&lt;SEP&gt;用于初始化智能体系统的子模块之一。&lt;SEP&gt;语言模型(LLM)用于分析游戏内文本数据，捕捉玩家行为模式和偏好特征，优化游戏机制与剧情。&lt;SEP&gt;语言模型(LLM)具有先进的语言处理能力，能解读指令并将其分解为机器人动作步骤，推动任务规划技术的发展。</data>
  <data key="d3">chunk-d93fe735e01199c9923a37c7ae1883d6&lt;SEP&gt;chunk-cd914358f4debb4d723fade8a4ad230b&lt;SEP&gt;chunk-482586672a0047f4c462d8517459bfc1&lt;SEP&gt;chunk-2230aca8700615684137959ad6aeaa19&lt;SEP&gt;chunk-b02bdc73192c08015a3db279f34e7a0b&lt;SEP&gt;chunk-f80348728a09db44b62eef1e469cc251&lt;SEP&gt;chunk-f4a289909c383f96b219df73de761192</data>
  <data key="d4">doc#6:part2/7&lt;SEP&gt;doc#6:part3/7</data>
  <data key="d5">1774587513</data>
  <data key="d6"></data>
</node>
<node id="视觉模型(VLM)">
  <data key="d0">视觉模型(VLM)</data>
  <data key="d1">技术</data>
