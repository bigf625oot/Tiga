</node>
<node id="InstructBLIP">
  <data key="d0">InstructBLIP</data>
  <data key="d1">技术</data>
  <data key="d2">当前最先进的开源多模态模型，采用冻结的CLIP模型作为视觉编码器。</data>
  <data key="d3">chunk-482586672a0047f4c462d8517459bfc1</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587364</data>
  <data key="d6"></data>
</node>
<node id="智能体transformer">
  <data key="d0">智能体transformer</data>
  <data key="d1">技术</data>
  <data key="d2">能同时接收视觉标记和语言标记作为输入的AI模型，类似于Gato模型。</data>
  <data key="d3">chunk-482586672a0047f4c462d8517459bfc1</data>
