  <data key="d0">图像描述生成</data>
  <data key="d1">方法</data>
  <data key="d2">图像描述生成是一种通过语言解析视觉内容并生成相关描述的任务，对于开发更接近人类互动方式的人工智能至关重要。</data>
  <data key="d3">chunk-d7780ea3252fd818bec43eaf2a9d6d5f</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587675</data>
  <data key="d6"></data>
</node>
<node id="视觉问答">
  <data key="d0">视觉问答</data>
  <data key="d1">方法</data>
  <data key="d2">视觉问答是一种知识密集型任务，涉及通过视觉内容回答问题，如OKVQA、KBVQA、FVQA和WebQA等。</data>
  <data key="d3">chunk-d7780ea3252fd818bec43eaf2a9d6d5f</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587675</data>
