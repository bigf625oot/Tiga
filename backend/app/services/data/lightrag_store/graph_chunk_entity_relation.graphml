<node id="机器人导航">
  <data key="d0">机器人导航</data>
  <data key="d1">技术</data>
  <data key="d2">机器人导航技术主要聚焦于基于地图的路径规划和同步定位与地图构建(SLAM)等核心功能。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff</data>
