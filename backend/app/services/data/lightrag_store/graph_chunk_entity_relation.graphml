</node>
<node id="医疗保健">
  <data key="d0">医疗保健</data>
  <data key="d1">概念</data>
  <data key="d2">医疗保健部分讨论了当前医疗保健能力及其在AI技术中的应用。</data>
  <data key="d3">chunk-eedd8b55b30b57a4f6a3d2765dbf5a0c</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587359</data>
  <data key="d6"></data>
</node>
<node id="多模态代理">
  <data key="d0">多模态代理</data>
  <data key="d1">技术</data>
  <data key="d2">多模态代理涉及图像语言理解与生成、视频和语言理解与生成等技术。</data>
  <data key="d3">chunk-eedd8b55b30b57a4f6a3d2765dbf5a0c</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587359</data>
