  <data key="d1">技术</data>
  <data key="d2">具身人工智能研究中的仿真平台之一，用于智能体的导航训练。</data>
  <data key="d3">chunk-5b074c1aa72922c8394e1f09b64305b6</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587512</data>
