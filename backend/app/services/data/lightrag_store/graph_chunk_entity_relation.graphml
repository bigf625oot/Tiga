</node>
<node id="SLAM">
  <data key="d0">SLAM</data>
  <data key="d1">技术</data>
  <data key="d2">同步定位与地图构建(SLAM)是机器人导航中的核心技术，用于创建环境地图。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="机器人操作系统ROS">
  <data key="d0">机器人操作系统ROS</data>
  <data key="d1">技术</data>
  <data key="d2">机器人操作系统ROS是一种广泛使用的机器人中间件，包含导航功能的标准配置。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="物体导航任务">
  <data key="d0">物体导航任务</data>
  <data key="d1">技术</data>
  <data key="d2">物体导航任务要求机器人通过物体名称而非地图坐标进行导航，需将物体名称与实际环境建立视觉关联。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="计算机视觉">
  <data key="d0">计算机视觉</data>
  <data key="d1">技术</data>
  <data key="d2">计算机视觉是近年来取得突破性进展的领域，对机器人导航技术有重要影响。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="自然语言处理">
  <data key="d0">自然语言处理</data>
  <data key="d1">技术</data>
  <data key="d2">自然语言处理是近年来取得突破性进展的领域，对机器人导航技术有重要影响。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="任务规划器">
  <data key="d0">任务规划器</data>
  <data key="d1">方法</data>
  <data key="d2">任务规划器是机器人教学系统中的一部分，用于创建动作序列并根据反馈进行调整。&lt;SEP&gt;任务规划器用于确保任务序列的连贯性，但依赖具体参数进行操作。</data>
  <data key="d3">chunk-3aa879ee3c4b9611f925638a11a8f3ff&lt;SEP&gt;chunk-9ac827f9635db35d4aabec05e0cfa96e</data>
  <data key="d4">doc#6:part3/7&lt;SEP&gt;doc#6:part4/7</data>
  <data key="d5">1774587676</data>
  <data key="d6"></data>
</node>
<node id="少量样本提示法">
  <data key="d0">少量样本提示法</data>
  <data key="d1">方法</data>
  <data key="d2">少量样本提示法通过在大型语言模型提示中嵌入任务示例，有效实现多种任务的上下文建模。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="火烈鸟(Flamingo)">
  <data key="d0">火烈鸟(Flamingo)</data>
  <data key="d1">技术</data>
  <data key="d2">火烈鸟是一种多模态基础模型，仅需少量示例即可完成各类视觉理解任务。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="BLIP-2">
  <data key="d0">BLIP-2</data>
  <data key="d1">技术</data>
  <data key="d2">BLIP-2是一种多模态基础模型，能够高效完成视觉理解任务。&lt;SEP&gt;BLIP-2是一种多模态系统，采用冻结的语言模型和视觉编码器组合方案。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b&lt;SEP&gt;chunk-e740f765777c5ea7ed337f281a348839</data>
  <data key="d4">doc#6:part3/7&lt;SEP&gt;doc#6:part4/7</data>
  <data key="d5">1774587675</data>
  <data key="d6"></data>
</node>
<node id="智能体系统">
  <data key="d0">智能体系统</data>
  <data key="d1">技术</data>
  <data key="d2">智能体系统是一种需要优化空间和时间维度的系统，用于协调和执行任务。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="大规模批量强化学习">
  <data key="d0">大规模批量强化学习</data>
  <data key="d1">方法</data>
  <data key="d2">大规模批量强化学习是一种用于优化智能体AI系统的方法，特别是在需要大量智能体并行运作的系统中。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="多样化协作规范">
  <data key="d0">多样化协作规范</data>
  <data key="d1">概念</data>
  <data key="d2">多样化协作规范是一种策略，用于训练能适应多种规范的智能体，以实现更好的协作效果。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="LLM-DP">
  <data key="d0">LLM-DP</data>
  <data key="d1">方法</data>
  <data key="d2">LLM-DP是一种用于任务调度和执行的方法，通过实时整合环境变量实现高效规划。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="ReAct">
  <data key="d0">ReAct</data>
  <data key="d1">方法</data>
  <data key="d2">ReAct是一种用于任务调度和执行的方法，通过动态调整动作衔接提升工作效率。</data>
  <data key="d3">chunk-ab4901fafa440ec8823a12ea4c13e75b</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587517</data>
  <data key="d6"></data>
</node>
<node id="语言输入">
  <data key="d0">语言输入</data>
  <data key="d3">chunk-c1664349bf3883472a0704f460d2582f</data>
  <data key="d2">任务与运动规划通过语言输入指导机器人任务规划。</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587527</data>
  <data key="d6"></data>
</node>
<node id="机器人技能">
  <data key="d0">机器人技能</data>
  <data key="d3">chunk-c1664349bf3883472a0704f460d2582f</data>
  <data key="d2">视觉语言模型用于将场景中的间接线索转化为机器人技能。</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">doc#6:part3/7</data>
  <data key="d5">1774587527</data>
  <data key="d6"></data>
</node>
<node id="FrozeninTime">
  <data key="d0">FrozeninTime</data>
  <data key="d1">技术</data>
  <data key="d2">采用时空注意力机制分割空间的模型。&lt;SEP&gt;FrozeninTime是一种时空注意力机制，用于分割空间，由Bain等人提出。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04&lt;SEP&gt;chunk-ed54ba9569bba0f5d62b972fa97fdac3</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="EVA-CLIP-G">
  <data key="d0">EVA-CLIP-G</data>
  <data key="d1">技术</data>
  <data key="d2">视觉编码器，用于指令式BERT模型的扩展。&lt;SEP&gt;EVA-CLIP-G是指令式BERT的视觉编码器，由Sun等人提出，用于视频描述任务。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04&lt;SEP&gt;chunk-ed54ba9569bba0f5d62b972fa97fdac3</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="Flan-T5-XL">
  <data key="d0">Flan-T5-XL</data>
  <data key="d1">技术</data>
  <data key="d2">Flan-T5-XL是一种大型语言模型，由Chung等人提出，用于训练过程中的冻结处理。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="WebVid10M数据集">
  <data key="d0">WebVid10M数据集</data>
  <data key="d1">数据</data>
  <data key="d2">WebVid10M数据集包含500万条视频描述，用于训练视频描述模型。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="视觉指令调谐方法">
  <data key="d0">视觉指令调谐方法</data>
  <data key="d1">方法</data>
  <data key="d2">视觉指令调谐方法用于视频描述任务，但存在捕捉精确视觉细节的局限性。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="多模态模型">
  <data key="d0">多模态模型</data>
  <data key="d1">技术</data>
  <data key="d2">多模态模型用于整合视觉、音频和文本模态，以实现更全面的视频理解。&lt;SEP&gt;基于现实场景的多模态模型可用于机器人和AI代理的内容生成，并在生产力应用中发挥重要作用。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04&lt;SEP&gt;chunk-e2ef7410e7527f97e5a17cc0f7836e7b</data>
  <data key="d4">doc#6:part4/7&lt;SEP&gt;doc#6:part5/7</data>
  <data key="d5">1774588101</data>
  <data key="d6"></data>
</node>
<node id="InstructBLIP变体">
  <data key="d0">InstructBLIP变体</data>
  <data key="d1">技术</data>
  <data key="d2">InstructBLIP变体是一种经过视频微调的模型，用于生成场景描述和回答与视频事件相关的问题。</data>
  <data key="d3">chunk-568703043aca105554aeba8ec28f4c04</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="视频描述">
  <data key="d0">视频描述</data>
  <data key="d1">概念</data>
  <data key="d2">视频描述是指通过整合视频的原始查询、标题、描述、音频转录内容以及特定时间段内的噪声描述，生成高质量、结构化的视频内容描述。</data>
  <data key="d3">chunk-5279b4e6943e0a1a7dde90ad9bd1d8e9</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="JSON格式">
  <data key="d0">JSON格式</data>
  <data key="d1">方法</data>
  <data key="d2">JSON格式是一种用于结构化数据的格式，GPT-4V使用它来输出视频描述，包含一个字典列表，每个字典详细描述视频的一个片段。</data>
  <data key="d3">chunk-5279b4e6943e0a1a7dde90ad9bd1d8e9</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="音频转录">
  <data key="d0">音频转录</data>
  <data key="d1">方法</data>
  <data key="d2">音频转录是指将视频中的音频内容转换为文本形式，格式为“[开始-结束时间(秒)]”“转录”。</data>
  <data key="d3">chunk-5279b4e6943e0a1a7dde90ad9bd1d8e9</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="噪声描述">
  <data key="d0">噪声描述</data>
  <data key="d1">方法</data>
  <data key="d2">噪声描述是指对视频特定时间点可能存在的噪声进行描述，格式为“[时间(秒)]”“description”。</data>
  <data key="d3">chunk-5279b4e6943e0a1a7dde90ad9bd1d8e9</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="MC创作">
  <data key="d0">MC创作</data>
  <data key="d1">概念</data>
  <data key="d2">MC创作是指为视频转文本检索任务设计选择题，这类问题只需查看标题并阅读音频转录内容即可轻松解决。</data>
  <data key="d3">chunk-5279b4e6943e0a1a7dde90ad9bd1d8e9</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="视频信息">
  <data key="d0">视频信息</data>
  <data key="d1">物品</data>
  <data key="d2">视频信息是用于提出否定性陈述的基础材料，需要对内容进行细致理解以证明否定性问题虽不正确但仍具有说服力。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="否定性陈述">
  <data key="d0">否定性陈述</data>
  <data key="d1">概念</data>
  <data key="d2">否定性陈述是通过改写原始查询生成的，虽不正确但仍具有说服力，需要基于视频内容的细致理解。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587673</data>
  <data key="d6"></data>
</node>
<node id="工具调用与知识库查询">
  <data key="d0">工具调用与知识库查询</data>
  <data key="d1">方法</data>
  <data key="d2">通过整合外部知识库、网络搜索等辅助工具到AI智能体推理流程中，提升理解能力和响应精准度。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="推理与规划能力">
  <data key="d0">推理与规划能力</data>
  <data key="d1">方法</data>
  <data key="d2">增强智能体的推理和规划能力，使其能理解复杂指令、推断用户意图并预测潜在场景。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="系统反馈与人类反馈机制">
  <data key="d0">系统反馈与人类反馈机制</data>
  <data key="d1">方法</data>
  <data key="d2">整合系统反馈和人类反馈机制，使智能体能够优化策略、修正错误，并提供符合用户需求的服务。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="ReAct模型">
  <data key="d0">ReAct模型</data>
  <data key="d1">技术</data>
  <data key="d2">ReAct模型是一种让智能体回顾过往行为与失败案例的方法，由姚等人提出。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="AutoGen项目">
  <data key="d0">AutoGen项目</data>
  <data key="d1">技术</data>
  <data key="d2">AutoGen项目是一种整合人类反馈机制的自适应学习项目，由吴等人提出。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="Self-Instruct">
  <data key="d0">Self-Instruct</data>
  <data key="d1">方法</data>
  <data key="d2">Self-Instruct是一种生成任务示例的方法，用于头脑风暴和任务生成。</data>
  <data key="d3">chunk-e9a27d557b083f97801b5398cccfbd25</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="超声心动图">
  <data key="d0">超声心动图</data>
  <data key="d1">技术</data>
  <data key="d2">用于可视化内部结构的医学诊断工具，常见于临床床边治疗场景。</data>
  <data key="d3">chunk-6a9e10a1b2f9f94b3965b9f641c4ad0d</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="交互式多模态智能体">
  <data key="d0">交互式多模态智能体</data>
  <data key="d1">技术</data>
  <data key="d2">包含交互、语音、视觉和语言四大核心模块的AI系统架构。</data>
  <data key="d3">chunk-6a9e10a1b2f9f94b3965b9f641c4ad0d</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="视频基础模型">
  <data key="d0">视频基础模型</data>
  <data key="d1">技术</data>
  <data key="d2">采用掩码预训练和对比预训练目标的视频理解模型，在动作识别任务中存在局限性。</data>
  <data key="d3">chunk-6a9e10a1b2f9f94b3965b9f641c4ad0d</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="GPT4-V">
  <data key="d0">GPT4-V</data>
  <data key="d1">技术</data>
  <data key="d2">图像-语言混合模型，可与专业工具结合实现复杂视频理解任务。&lt;SEP&gt;GPT4-V是一种结合视觉、音频和语音领域专业工具的技术，用于实现长视频中角色动作脚本化等复杂理解任务。</data>
  <data key="d3">chunk-6a9e10a1b2f9f94b3965b9f641c4ad0d&lt;SEP&gt;chunk-47cd7c5429a8f83be3c5c95323edd554</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
<node id="李等人">
  <data key="d0">李等人</data>
  <data key="d1">人物</data>
  <data key="d2">参与视频基础模型研究的科研团队(2021-2023年)。</data>
  <data key="d3">chunk-6a9e10a1b2f9f94b3965b9f641c4ad0d</data>
  <data key="d4">doc#6:part4/7</data>
  <data key="d5">1774587674</data>
  <data key="d6"></data>
</node>
