  <data key="d0">专家数据</data>
  <data key="d1">数据</data>
  <data key="d2">包含专家示范的状态-动作对的数据，用于训练智能体。</data>
  <data key="d3">chunk-64f7df7aec3757b7c0ad9192079682b3</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="上下文提示">
  <data key="d0">上下文提示</data>
  <data key="d1">方法</data>
  <data key="d2">用于训练智能体的机制，能捕捉专家行为的关键特征。</data>
  <data key="d3">chunk-64f7df7aec3757b7c0ad9192079682b3</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
