</node>
<node id="中间层系统">
  <data key="d0">中间层系统</data>
  <data key="d1">技术</data>
  <data key="d2">支持人工预审与修改的中间层系统，提升系统在人类指导下运行的可靠性。</data>
  <data key="d3">chunk-be21bd51fca6481ac3aa3e712fa43bd1</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
  <data key="d6"></data>
</node>
<node id="交互式智能体AI系统">
  <data key="d0">交互式智能体AI系统</data>
  <data key="d1">技术</data>
  <data key="d2">一种应用广泛的智能体系统，但在未知环境或场景中的泛化能力存在短板。</data>
  <data key="d3">chunk-be21bd51fca6481ac3aa3e712fa43bd1</data>
  <data key="d4">doc#6:part2/7</data>
  <data key="d5">1774587360</data>
