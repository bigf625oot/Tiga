  <data key="d1">组织</data>
  <data key="d2">Meta旗下的研究团队，专注于人工智能基础研究，包括游戏AI等领域。</data>
  <data key="d3">chunk-5b074c1aa72922c8394e1f09b64305b6</data>
  <data key="d4">doc#6:part3/7</data>
