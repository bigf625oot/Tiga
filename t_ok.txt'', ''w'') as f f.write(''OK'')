[32m+[m[32mclass TaskPlanParser:[m
[32m+[m[32m    """[m
[32m+[m[32m    终极协议解析器：[m
[32m+[m[32m    采用 预清洗 -> 启发式提取 -> 深度验证 -> 错误回溯 的闭环逻辑[m
[32m+[m[32m    """[m
[32m+[m[41m    [m
[32m+[m[32m    def __init__(self, model_class: Type[T] = TaskPlan):[m
[32m+[m[32m        self.model_class = model_class[m
[32m+[m[32m        self.logger = logging.getLogger("TaskPlanParser")[m
[32m+[m
[32m+[m[32m    def _yield_candidates(self, raw_text: str) -> Generator[str, None, None]:[m
[32m+[m[32m        """启发式候选块生成器"""[m
[32m+[m[32m        # 1. 优先级最高：Markdown 代码块[m
[32m+[m[32m        found_fence = False[m
[32m+[m[32m        for match in JsonFixer._FENCES.finditer(raw_text):[m
[32m+[m[32m            found_fence = True[m
[32m+[m[32m            yield match.group(1)[m
[32m+[m[41m        [m
[32m+[m[32m        # 2. 优先级中等：首尾大括号贪婪匹配[m
[32m+[m[32m        start = raw_text.find("{")[m
[32m+[m[32m        end = raw_text.rfind("}")[m
[32m+[m[32m        if start != -1 and end != -1 and end > start:[m
[32m+[m[32m            # 如果之前没找到过 fence，或者这个括号块比 fence 长，则尝试[m
[32m+[m[32m            yield raw_text[start : end + 1][m
[32m+[m[41m        [m
[32m+[m[32m        # 3. 优先级低：全文直接尝试[m
[32m+[m[32m        if not found_fence:[m
[32m+[m[32m            yield raw_text[m
[32m+[m
[32m+[m[32m    def _validate_dict(self, payload: Dict, raw_input: str) -> T:[m
[32m+[m[32m        """[m
[32m+[m[32m        深度验证：将 Pydantic 晦涩的错误转化为开发者和 LLM 都能秒懂的描述[m
[32m+[m[32m        """[m
[32m+[m[32m        try:[m
[32m+[m[32m            return self.model_class.model_validate(payload)[m
[32m+[m[32m        except ValidationError as e:[m
[32m+[m[32m            readable_errors = [][m
[32m+[m[32m            for err in e.errors():[m
[32m+[m[32m                # 构造路径：例如 "steps.0.tool_name"[m
[32m+[m[32m                loc = ".".join(str(p) for p in err['loc'])[m
[32m+[m[32m                msg = err['msg'][m
[32m+[m[32m                input_val = err.get('input', 'N/A')[m
[32m+[m[32m                readable_errors.append({[m
[32m+[m[32m                    "path": loc,[m
[32m+[m[32m                    "issue": msg,[m
[32m+[m[32m                    "received": input_val[m
[32m+[m[32m                })[m
[32m+[m[41m            [m
[32m+[m[32m            # 记录详细日志供审计[m
[32m+[m[32m            self.logger.warning(f"Validation failed for schema {self.model_class.__name__}: {readable_errors}")[m
[32m+[m[41m            [m
[32m+[m[32m            raise PlanValidationError([m
[32m+[m[32m                message=f"Schema validation failed: Found {len(readable_errors)} issues.",[m
[32m+[m[32m                errors=readable_errors,[m
[32m+[m[32m                raw_content=raw_input,[m
[32m+[m[32m                diagnostics={"type": "pydantic_validation_error"}[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m[32m    def parse(self, data: Any) -> T:[m
[32m+[m[32m        """解析主逻辑"""[m
[32m+[m[32m        if isinstance(data, self.model_class):[m
[32m+[m[32m            return data[m
[32m+[m[41m        [m
[32m+[m[32m        if isinstance(data, dict):[m
[32m+[m[32m            return self._validate_dict(data, str(data))[m
[32m+[m
[32m+[m[32m        if not isinstance(data, str):[m
[32m+[m[32m            raise PlanError(f"Critical: Expected string or dict, got {type(data)}")[m
[32m+[m
[32m+[m[32m        last_err = None[m
[32m+[m[32m        # 尝试所有候选文本块[m
[32m+[m[32m        for candidate in self._yield_candidates(data):[m
[32m+[m[32m            cleaned = JsonFixer.clean(candidate)[m
[32m+[m[32m            try:[m
[32m+[m[32m                # 1. 尝试 JSON 反序列化[m
[32m+[m[32m                obj = json.loads(cleaned)[m
[32m+[m[32m                if not isinstance(obj, dict):[m
[32m+[m[32m                    continue[m
[32m+[m[32m                # 2. 尝试 Pydantic 业务验证[m
[32m+[m[32m                return self._validate_dict(obj, data)[m
[32m+[m[32m            except (json.JSONDecodeError, PlanValidationError) as e:[m
[32m+[m[32m                last_err = e[m
[32m+[m[32m                continue[m
[32m+[m
[32m+[m[32m        # 最终兜底：如果循环结束还没返回，抛出汇总异常[m
[32m+[m[32m        if isinstance(last_err, PlanValidationError):[m
[32m+[m[32m            raise last_err[m
[32m+[m[41m        [m
[32m+[m[32m        raise PlanParseError([m
[32m+[m[32m            message="Failed to extract a valid TaskPlan JSON structure from the output.",[m
[32m+[m[32m            raw_content=data,[m
[32m+[m[32m            diagnostics={"error_type": "extraction_failure"}[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m
[32m+[m[32m_DEFAULT_TASK_PLAN_PARSER = TaskPlanParser(TaskPlan)[m
