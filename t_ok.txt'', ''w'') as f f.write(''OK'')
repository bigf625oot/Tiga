[32m+[m[32mclass JsonFixer:[m
[32m+[m[32m    """具备自愈能力的 JSON 净化器"""[m
[32m+[m[32m    _FENCES = re.compile(r"```(?:json)?\s*([\s\S]*?)\s*```", re.IGNORECASE)[m
[32m+[m[32m    _PY_CONST = re.compile(r"\b(True|False|None)\b")[m
[32m+[m[32m    _TRAILING_COMMA = re.compile(r",\s*([\]}])")[m
[32m+[m[32m    _SINGLE_QUOTE_KEY = re.compile(r"'(\w+)'\s*:") # 修复单引号key[m
[32m+[m[32m    _CONTROL_CHARS = re.compile(r"[\x00-\x1F\x7F]") # 移除不可见控制字符[m
[32m+[m
[32m+[m[32m    @classmethod[m
[32m+[m[32m    def clean(cls, text: str) -> str:[m
[32m+[m[32m        t = text.strip()[m
[32m+[m[32m        # 移除不可见字符（LLM有时会输出乱码）[m
[32m+[m[32m        t = cls._CONTROL_CHARS.sub("", t)[m
[32m+[m[32m        # 修正 Python 特有布尔值/空值[m
[32m+[m[32m        t = cls._PY_CONST.sub(lambda m: {"True":"true","False":"false","None":"null"}[m.group(1)], t)[m
[32m+[m[32m        # 修正单引号 key (例如 'steps': -> "steps":)[m
[32m+[m[32m        t = cls._SINGLE_QUOTE_KEY.sub(r'"\1":', t)[m
[32m+[m[32m        # 移除 JSON 数组或对象末尾多余的逗号[m
[32m+[m[32m        t = cls._TRAILING_COMMA.sub(r"\1", t)[m
[32m+[m[32m        return t[m
